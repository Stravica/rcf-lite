{
  "slug": "application-onboarding-tour",
  "version": "1.1.3",
  "category": "application",
  "elicits": [
    {
      "id": "tour-step-manifest",
      "prompt": "Tour step manifest: an ordered list of 3 to 5 steps, each with an anchor selector (CSS) and a content voice slot the project fills. Names each step id, anchor, heading and body.",
      "kind": "string",
      "default": ""
    },
    {
      "id": "anchor-selectors",
      "prompt": "Anchor selectors: CSS selectors the runtime resolves at step-open time to place the tooltip. One per manifest step.",
      "kind": "string",
      "default": ""
    },
    {
      "id": "per-step-content-voice",
      "prompt": "Per-step content voice: the project-owned copy for each step (heading and body). The blueprint contributes the WHAT, not the words.",
      "kind": "string",
      "default": ""
    },
    {
      "id": "dismissal-policy",
      "prompt": "Dismissal policy: dismiss-permanently (the tour never re-opens for a returning principal), dismiss-until-next-major (re-opens on a major version bump of the applied blueprint set), or dismiss-until-next-minor (re-opens on a minor bump). Recommended default: dismiss-permanently.",
      "kind": "enum",
      "options": [
        "dismiss-permanently",
        "dismiss-until-next-major",
        "dismiss-until-next-minor"
      ],
      "default": "dismiss-permanently"
    },
    {
      "id": "completion-state-store",
      "prompt": "Completion-state store shape: spa-local-storage (per-browser, the Q4 fallback when no persistence blueprint is applied), spa-session-storage (per-session, re-plays on every new session), or server-side-per-principal (follows the principal across devices; requires an applied persistence blueprint). Recommended default: spa-local-storage.",
      "kind": "enum",
      "options": [
        "spa-local-storage",
        "spa-session-storage",
        "server-side-per-principal"
      ],
      "default": "spa-local-storage"
    },
    {
      "id": "checklist-anchor",
      "prompt": "Checklist anchor slot: dashboard-top (renders on the dashboard shell when application-dashboard is applied), settings-page (renders on the settings surface when application-account-settings is applied or on any settings surface as a fallback), or custom-anchor (the project supplies a CSS selector). Default derived at apply time from what is applied.",
      "kind": "enum",
      "options": [
        "dashboard-top",
        "settings-page",
        "custom-anchor"
      ],
      "default": "dashboard-top"
    }
  ],
  "suggestedCompanions": [
    {
      "role": "logging",
      "reason": "Every step transition and tour completion writes one request-scoped log line with the correlation identifier; a logging companion supplies the factory."
    },
    {
      "role": "errorHandling",
      "reason": "A completion-state persistence failure constructs an internal error record; an error-handling companion supplies the record factory and the boundary."
    }
  ],
