  "elicits": [
    {
      "id": "step-manifest",
      "prompt": "Wizard step manifest: comma-separated step slugs in order.",
      "kind": "string",
      "default": "about,detail,confirm"
    },
    {
      "id": "navigation",
      "prompt": "Step navigation model: linear (steps are gated by prerequisites) or free (any step reachable at any time).",
      "kind": "enum",
      "options": [
        "linear",
        "free"
      ],
      "default": "linear"
    },
    {
      "id": "step-indicator",
      "prompt": "Step-indicator surface: task-list (recommended default), aria-progressbar-only, or breadcrumb.",
      "kind": "enum",
      "options": [
        "task-list",
        "aria-progressbar-only",
        "breadcrumb"
      ],
      "default": "task-list"
    },
    {
      "id": "draft-transport",
      "prompt": "Draft persistence transport: spa-local-storage (default), server-scoped, or none.",
      "kind": "enum",
      "options": [
        "spa-local-storage",
        "server-scoped",
        "none"
      ],
      "default": "spa-local-storage"
    },
    {
      "id": "validation-policy",
      "prompt": "Validation policy: on-blur-then-on-change (default per REQ-002), on-change-always, or on-submit-only.",
      "kind": "enum",
      "options": [
        "on-blur-then-on-change",
        "on-change-always",
        "on-submit-only"
      ],
      "default": "on-blur-then-on-change"
    }
  ]
}
