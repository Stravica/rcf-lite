    },
    {
      "id": "ADR-3002-messaging-queue-cloudflare-delivery-semantics",
      "kind": "adr",
      "path": "adrs/adr-3002-messaging-queue-cloudflare-delivery-semantics.json",
      "scope": "global",
      "topic": "deliverySemantics",
      "standardsTraceClause": "WSD-005 clauses on at-least-once and out-of-order tolerance"
    },
    {
      "id": "ADR-3003-messaging-queue-cloudflare-max-attempts-floor",
      "kind": "adr",
      "path": "adrs/adr-3003-messaging-queue-cloudflare-max-attempts-floor.json",
      "recommendedDefault": true,
      "elicited": true,
      "standardsTraceClause": "Cloudflare Queues default retry limit 3 and documented ceiling 100"
    },
    {
      "id": "ADR-3004-messaging-queue-cloudflare-batch-defaults",
      "kind": "adr",
      "path": "adrs/adr-3004-messaging-queue-cloudflare-batch-defaults.json",
      "recommendedDefault": true,
      "elicited": true,
      "standardsTraceClause": "Cloudflare Queues per-consumer batch settings"
    }
  ],
  "elicits": [
    {
      "id": "queue-binding-name",
      "prompt": "The Queues binding name declared under wrangler.toml [[queues.producers]] and [[queues.consumers]]. The producer facade reads env under this name at boot.",
      "kind": "string",
      "default": "RCF_TEST_QUEUE"
    },
    {
      "id": "queue-name",
      "prompt": "The Cloudflare Queues queue name the binding resolves to. The applied project asserts a real account queue at apply.",
      "kind": "string",
      "default": "app-queue"
    },
    {
      "id": "max-attempts",
      "prompt": "Max delivery attempts per ADR-3003 before a message crosses into the DLQ. Default 3 per the Cloudflare Queues documented default; floor 1; ceiling 100 per the Queues platform-limits page.",
      "kind": "string",
      "default": "3"
    },
    {
      "id": "dead-letter-queue",
      "prompt": "Dead-letter queue name attached under [[queues.consumers]].dead_letter_queue for the consumer. A dead-lettered message is stamped messageDeadLettered on the lifecycle sink; retention is 4 days per ADR-3003.",
      "kind": "string",
      "default": "app-queue-dlq"
    },
    {
      "id": "batch-size",
      "prompt": "max_batch_size for the consumer. Default 10 per ADR-3004; bounded above by 100 per the Cloudflare Queues platform-limits page.",
      "kind": "string",
      "default": "10"
    },
    {
      "id": "batch-timeout-seconds",
      "prompt": "max_batch_timeout seconds for the consumer. Default 5 per ADR-3004; bounded above by 60 per the Cloudflare Queues platform-limits page.",
      "kind": "string",
      "default": "5"
    }
  ]
}
