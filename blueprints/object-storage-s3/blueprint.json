  "elicits": [
    {
      "id": "s3-endpoint-url",
      "prompt": "S3-compatible endpoint URL: an AWS S3 URL, a Cloudflare R2 URL, a MinIO URL, or any S3-compatible remote (including Hetzner Object Storage under the endpoint-shape helper). The facade opens the client against this at boot.",
      "kind": "string",
      "default": "https://s3.amazonaws.com"
    },
    {
      "id": "s3-bucket-name",
      "prompt": "Bucket name the facade opens against. The applied project asserts a real bucket at apply; the facade dereferences the elicited value once at boot.",
      "kind": "string",
      "default": "app-bucket"
    },
    {
      "id": "s3-adapter",
      "prompt": "S3 client adapter per ADR-2901. aws-sdk-client-s3 is the AWS SDK v3 client for Node targets; aws4fetch is the small SigV4 fetch adapter for Workers targets.",
      "kind": "enum",
      "options": [
        "aws-sdk-client-s3",
        "aws4fetch"
      ],
      "default": "aws-sdk-client-s3"
    },
    {
      "id": "presigned-ttl-ceiling-seconds",
      "prompt": "Ceiling on the TTL a presignGetUrl verb may accept, in seconds. Floor is 60 seconds; default cap is 3600 seconds; the shipped default TTL is 900 seconds per ADR-2902.",
      "kind": "string",
      "default": "3600"
    },
    {
      "id": "multipart-threshold-bytes",
      "prompt": "Payload size at or above which the put path switches to multipart-upload. Default 8388608 bytes (8 MiB) per ADR-2903.",
      "kind": "string",
      "default": "8388608"
    },
    {
      "id": "hetzner-location-code",
      "prompt": "Hetzner Object Storage location code per the Hetzner storage overview: fsn1 Falkenstein, hel1 Helsinki, nbg1 Nuremberg. Only meaningful when the endpoint composes through the Hetzner endpoint-shape helper (TAC-2904).",
      "kind": "enum",
      "options": [
        "fsn1",
        "hel1",
        "nbg1"
      ],
      "default": "fsn1"
    }
  ],
  "updatedAt": "2026-09-11"
}
