{
  "slug": "observability-logging",
  "version": "1.3.3",
  "category": "observability",
  "providesRoles": [
    "logging"
  ],
  "capabilities": [
    "auditLog"
  ],
  "elicits": [
    {
      "id": "correlation-header-name",
      "prompt": "Inbound correlation header name accepted and reflected on outbound requests (per ADR-1602; recommended default X-Correlation-Id, elicited alternative per project).",
      "kind": "string",
      "default": "X-Correlation-Id"
    },
    {
      "id": "minimum-log-level",
      "prompt": "Minimum log level per environment (per ADR-1604 vocabulary trace / debug / info / warn / error / fatal; the factory refuses emissions below this level).",
      "kind": "enum",
      "options": [
        "trace",
        "debug",
        "info",
        "warn",
        "error",
        "fatal"
      ],
      "default": "info"
    },
    {
      "id": "redaction-categories-additions",
      "prompt": "Additional PII redaction categories on top of the recommended defaults (credential, pii.email, pii.name, pii.address, token, bearer per ADR-1603). Kebab-cased or dotted-namespace names; comma-separated list, blank when none.",
      "kind": "string",
      "default": ""
    },
    {
      "id": "boot-identity-fields",
      "prompt": "Boot identity: JSON object with environment, serviceName and serviceVersion string values the factory carries on every emitted line (REQ-005). All three refuse construction when blank.",
      "kind": "string",
      "default": "{\"environment\":\"\",\"serviceName\":\"\",\"serviceVersion\":\"\"}"
    }
  ],
