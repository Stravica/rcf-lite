{
  "slug": "platform-cloudflare-durable-objects",
  "version": "1.1.0",
  "category": "platform",
  "capabilities": [
    "strongConsistencyCell",
    "hibernatableWebSocket"
  ],
  "suggestedCompanions": [
    {
      "role": "logging",
      "reason": "Every namespaceReady, doAccept, doAlarmFired, doWakeUp and doHibernate event writes through the applied logger; a logging companion supplies the sink factory."
    },
    {
      "role": "errorHandling",
      "reason": "A namespace binding miss, an alarm handler throwing, a hub broadcast failure constructs an internal error record; an error-handling companion supplies the record factory and the boundary."
    }
  ],
  "elicits": [
    {
      "id": "do-cell-binding",
      "prompt": "Durable Object namespace binding name for the single-cell shape (a stable identifier in wrangler.toml under [[durable_objects.bindings]]; recommended default CELL).",
      "kind": "string",
      "default": "CELL"
    },
    {
      "id": "do-hub-binding",
      "prompt": "Durable Object namespace binding name for the hibernatable-WebSocket hub shape (recommended default HUB).",
      "kind": "string",
      "default": "HUB"
    },
    {
      "id": "do-cell-class-name",
      "prompt": "Stable class name string for the single-cell class exported from src/do-single-cell.mjs; committed under [[migrations]] on the v1 mint tag (recommended default SingleCellObject).",
      "kind": "string",
      "default": "SingleCellObject"
    },
    {
      "id": "do-hub-class-name",
      "prompt": "Stable class name string for the hub class exported from src/do-hub.mjs; committed under [[migrations]] on the v1 mint tag (recommended default HubObject).",
      "kind": "string",
      "default": "HubObject"
    },
    {
      "id": "do-storage-backend",
      "prompt": "Storage backend for the single-cell class per ADR-3403: sql (typed columns, query) or kv (simple put/get/delete/list). Recommended default sql.",
      "kind": "enum",
      "options": [
        "sql",
        "kv"
      ],
      "default": "sql"
    },
    {
      "id": "do-hub-broadcast-window-ms",
      "prompt": "Broadcast delivery window per HubObject fan-out, in milliseconds (recommended default 500).",
      "kind": "string",
      "default": "500"
    },
    {
      "id": "do-hub-hibernate-after-idle-ms",
      "prompt": "Hibernate-after-idle window per ADR-3405, in milliseconds (recommended default 30000; a coordinated-multiplayer workload with tight latency budgets picks a longer window).",
      "kind": "string",
      "default": "30000"
    }
  ],
