{
  "slug": "platform-cloudflare-cron-triggers",
  "version": "1.1.3",
  "category": "platform",
  "capabilities": [
    "scheduledTrigger"
  ],
  "suggestedCompanions": [
    {
      "role": "logging",
      "reason": "Every scheduled fire emits a metadata-only lifecycle event through the applied logger; a logging companion supplies the sink factory."
    },
    {
      "role": "errorHandling",
      "reason": "A handler failure inside a scheduled invocation constructs an internal error record; an error-handling companion supplies the record factory and the boundary."
    }
  ],
  "elicits": [
    {
      "id": "cron-expressions",
      "prompt": "Cron expressions to schedule (comma-separated list of POSIX cron strings; each expression pairs with one handler under the dispatcher; recommended shape at least one).",
      "kind": "string",
      "default": "* * * * *"
    },
    {
      "id": "cron-dispatcher-mode",
      "prompt": "Dispatcher mode: single-handler routes every fire to one handler; expression-routed maps each expression to a distinct handler (per ADR-3302; recommended default expression-routed when more than one cron expression is elicited).",
      "kind": "enum",
      "options": [
        "single-handler",
        "expression-routed"
      ],
      "default": "expression-routed"
    },
    {
      "id": "cron-skew-tolerance-seconds",
      "prompt": "Skew tolerance in seconds; fires observed within the window are onTime, fires outside record cronSkewed with the delta (per ADR-3303; floor 5 seconds, ceiling 300 seconds).",
      "kind": "string",
      "default": "30"
    },
    {
      "id": "cron-soft-budget-seconds",
      "prompt": "Soft budget per handler in seconds; a handler running past this budget logs cronStalled but is not terminated by the dispatcher (Cloudflare's platform concern retains termination). Recommended default 30.",
      "kind": "string",
      "default": "30"
    }
  ],
