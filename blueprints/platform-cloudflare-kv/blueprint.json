{
  "slug": "platform-cloudflare-kv",
  "version": "1.1.1",
  "category": "platform",
  "capabilities": [
    "keyValueStore"
  ],
  "suggestedCompanions": [
    {
      "role": "logging",
      "reason": "Every KV facade operation emits a metadata-only lifecycle event through the applied logger; a logging companion supplies the sink factory."
    },
    {
      "role": "errorHandling",
      "reason": "A KV read or write failure constructs an internal error record; an error-handling companion supplies the record factory and the boundary."
    }
  ],
  "elicits": [
    {
      "id": "kv-binding-name",
      "prompt": "What is the KV namespace binding name to use in wrangler.toml? (default: CACHE)",
      "kind": "string",
      "default": "CACHE"
    },
    {
      "id": "kv-default-cache-ttl-seconds",
      "prompt": "Default cache-aside TTL in seconds (floor 1, per ADR-3202; the shipped default aligns with the Cloudflare KV documented 60-second cache TTL)",
      "kind": "string",
      "default": "60"
    },
    {
      "id": "kv-metadata-field-pattern",
      "prompt": "Default metadata field pattern on put and getWithMetadata (JSON serialisable object; recommended default {v: number} for a per-key schema version)",
      "kind": "string",
      "default": "{\"v\":1}"
    },
    {
      "id": "kv-key-naming-convention",
      "prompt": "Key naming convention: prefixed (domain prefix like users/, flags/) or flat (per ADR-3203; recommended default prefixed)",
      "kind": "enum",
      "options": [
        "prefixed",
        "flat"
      ],
      "default": "prefixed"
    }
  ],
  "contributions": [
