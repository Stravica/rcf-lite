# Round-7 T-2 fixture Caddyfile. Reverse-proxy the throwaway web service
# under a fixture hostname on the shared throwaway-Hetzner-server fixture.
# docker compose exec caddy caddy reload picks up changes to this file.
{
	admin 0.0.0.0:2019
	auto_https off
}

:80 {
	@live path /live
	handle @live {
		respond "ok" 200
	}
	handle {
		reverse_proxy web:8080
	}
	log {
		output stdout
	}
}
