    "test:rcf:ui": "playwright test",
    "serve": "node src/preview-server.ts",
    "type-check": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
