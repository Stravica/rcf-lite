{
  "name": "slug-preview",
  "version": "0.1.0",
  "private": true,
  "description": "Synthetic fixture: a slug utility and its preview page; vitest specs plus one @playwright/test spec.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "npm run test:rcf",
